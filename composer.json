{
  "name": "cartesio/toolkit",
  "type": "wordpress-muplugin",
  "license": "proprietary",
  "description": "Infrastruttura condivisa dei progetti WordPress Cartesio: migrazioni versionate del database, guardrail sugli ambienti non-production, separazione fra editing di contenuti e di struttura.",
  "keywords": ["wordpress", "bedrock", "migrations", "woocommerce"],
  "authors": [
    { "name": "Cartesio" }
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.3"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  }
}
